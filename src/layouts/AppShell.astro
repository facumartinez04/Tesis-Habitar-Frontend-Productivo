---
import SiteLayout from './SiteLayout.astro';
import AppHeader from '../components/app/AppHeader.astro';
import AppSidebar, { type AppSidebarItem } from '../components/app/AppSidebar.astro';
import { ImpersonationBanner } from '../components/react/features/ImpersonationBanner';

interface Props {
  title: string;
  sectionLabel: string;
  sidebarItems: AppSidebarItem[];
}

const { title, sectionLabel, sidebarItems } = Astro.props;
---
<SiteLayout title={title}>
  <div data-print-hide class="contents"><ImpersonationBanner client:load /></div>
  <div class="min-h-screen flex">
    <div data-print-hide class="contents"><AppSidebar items={sidebarItems} sectionLabel={sectionLabel} /></div>
    <div class="flex-1 min-w-0 flex flex-col">
      <div data-print-hide class="contents"><AppHeader sectionLabel={sectionLabel} /></div>
      <main class="flex-1 min-w-0 p-4 sm:p-6 bg-surface" transition:animate="fade">
        <div class="max-w-5xl mx-auto">
          <slot />
        </div>
      </main>
    </div>
  </div>
</SiteLayout>
