---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  image?: string;
  forceLight?: boolean;
}

const {
  title,
  description = 'Habitar — Comprensión lectora asistida por Inteligencia Artificial, analítica formativa y diagnóstica para instituciones educativas.',
  image = '/logo-habitar.jpg',
  forceLight = false,
} = Astro.props;

const isLanding = forceLight || Astro.url.pathname === '/' || Astro.url.pathname === '';

const siteUrl = 'https://habitar.lat';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const fullImageUrl = new URL(image, siteUrl).href;

const pageTitle = title.startsWith('Habitar') ? title : `Habitar — ${title}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'Habitar',
      applicationCategory: 'EducationalApplication',
      operatingSystem: 'Web',
      description,
      url: siteUrl,
      image: fullImageUrl,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    },
    {
      '@type': 'EducationalOrganization',
      name: 'Habitar',
      url: siteUrl,
      logo: fullImageUrl,
      description: 'Plataforma edtech de comprensión lectora asistida por IA para instituciones educativas.',
    },
  ],
};
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="comprensión lectora, inteligencia artificial, analítica educativa, rúbricas pedagógicas, evaluación formativa, colegios, educación primaria, educación secundaria, Habitar" />
    <meta name="author" content="Habitar" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    {/* Open Graph / Facebook */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:site_name" content="Habitar" />
    <meta property="og:locale" content="es_AR" />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />

    {/* PWA & Icons */}
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0F6E56" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    {/* Client-Side Routing & View Transitions (Navegación SPA sin recarga) */}
    <ClientRouter />

    {/* Google Fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=DM+Mono:wght@400;500&display=swap"
    />

    {/* Structured Data (Schema.org) */}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {/* Inline Theme Detection (Prevents FOUC across Claro / Oscuro / Sistema y navegación SPA) */}
    <script is:inline define:vars={{ isLanding }}>
      function applyTheme() {
        try {
          const root = document.documentElement;
          const currentPath = window.location.pathname;
          const onLanding = isLanding || currentPath === '/' || currentPath === '';
          if (onLanding) {
            // El landing page siempre queda en modo claro
            root.classList.remove('dark');
            root.setAttribute('data-theme', 'light');
            root.setAttribute('data-theme-preference', 'light');
          } else {
            const stored = localStorage.getItem('habitar-theme') || 'system';
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            const isDark = stored === 'dark' || (stored === 'system' && prefersDark);
            if (isDark) {
              root.classList.add('dark');
              root.setAttribute('data-theme', 'dark');
            } else {
              root.classList.remove('dark');
              root.setAttribute('data-theme', 'light');
            }
            root.setAttribute('data-theme-preference', stored);
          }

          // Auto-redirección para Alumno guardado en PWA
          const userRole = localStorage.getItem('habitar_user_role');
          const isSwitch = new URLSearchParams(window.location.search).has('switch');
          if (userRole === 'alumno' && (currentPath === '/' || currentPath === '/login') && !isSwitch) {
            window.location.replace('/actividad');
          }
        } catch (e) {}
      }

      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
      document.addEventListener('astro:page-load', applyTheme);
    </script>
  </head>
  <body class="min-h-screen bg-surface text-text-pri transition-colors duration-200">
    <slot />
    <script>
      if ('serviceWorker' in navigator) {
        import('virtual:pwa-register').then(({ registerSW }) =>
          registerSW({
            immediate: true,
            onNeedRefresh() {
              window.location.reload();
            },
          })
        );
      }
    </script>
  </body>
</html>
