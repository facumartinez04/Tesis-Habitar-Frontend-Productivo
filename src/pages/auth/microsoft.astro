<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Conectando con OneDrive</title>
    <style>      body { margin: 0; min-height: 100vh; display: grid; place-items: center; font-family: system-ui, sans-serif; background: #0d0f14; color: #9ca3af; font-size: 13px; }
    </style>
  </head>
  <body>
    <p data-i18n="Conectando con OneDrive…">Conectando con OneDrive…</p>
    <script>      import { broadcastResponseToMainFrame } from '@azure/msal-browser/redirect-bridge';
      import { t } from '../../i18n';
      import { translateDocument } from '../../i18n/dom';
      translateDocument();
      broadcastResponseToMainFrame().catch(() => {
        document.body.textContent = t('No se pudo completar la conexión con OneDrive. Cerrá esta ventana e intentá de nuevo.');
      });
    </script>
  </body>
</html>
