---
import Icon from './Icon.astro';
import { SessionUserBadge } from '../react/features/SessionUserBadge';
import { ThemeToggle } from '../react/ui/ThemeToggle';
import { LanguageSelect } from '../react/ui/LanguageSelect';
import { TourButton } from '../react/features/TourButton';

interface Props {
  sectionLabel: string;
}

const { sectionLabel } = Astro.props;
---
<header class="bg-white dark:bg-[#161A24] border-b border-gray-200 dark:border-gray-800 px-4 sm:px-6 h-14 flex items-center justify-between shrink-0 transition-colors">
  <div class="flex items-center gap-3 min-w-0">
    <button
      id="sidebar-toggle"
      type="button"
      aria-label="Abrir menú"
      data-i18n-aria-label="Abrir menú"
      class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 md:hidden shrink-0 p-1 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors cursor-pointer"
    >
      <Icon name="menu" size={20} />
    </button>
    <h1 class="text-sm font-semibold text-gray-900 dark:text-gray-100 truncate" data-i18n={sectionLabel}>{sectionLabel}</h1>
  </div>
  <div class="flex items-center gap-2 sm:gap-3" data-tour="header-tools">
    <TourButton client:load />
    <LanguageSelect client:load />
    <ThemeToggle client:load />
    <SessionUserBadge client:load />
  </div>
</header>
