---
import Icon from './Icon.astro';
import { SessionUserBadge } from '../react/features/SessionUserBadge';

interface Props {
  sectionLabel: string;
}

const { sectionLabel } = Astro.props;
---
<header class="bg-white border-b border-gray-border px-4 sm:px-6 py-3 flex items-center justify-between shrink-0">
  <div class="flex items-center gap-3 min-w-0">
    <button
      id="sidebar-toggle"
      type="button"
      aria-label="Abrir menú"
      class="text-text-sec md:hidden shrink-0"
    >
      <Icon name="menu" size={20} />
    </button>
    <span class="text-[13px] font-medium text-text-pri truncate">{sectionLabel}</span>
  </div>
  <SessionUserBadge client:load />
</header>
