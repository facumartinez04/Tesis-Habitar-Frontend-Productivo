---
import Icon from './Icon.astro';
import type { IconName } from '../../lib/iconPaths';

export interface AppSidebarItem {
  icon: IconName;
  label: string;
  href: string;
  badgeCount?: number;
}

interface Props {
  items: AppSidebarItem[];
  sectionLabel: string;
}

const { items, sectionLabel } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<div
  id="sidebar-backdrop"
  class="hidden fixed inset-0 bg-black/50 backdrop-blur-xs z-30 md:hidden transition-opacity"
></div>
<aside
  id="app-sidebar"
  class="fixed inset-y-0 left-0 z-40 w-[256px] -translate-x-full transition-transform duration-200 ease-out shrink-0 bg-[#0A4D3C] text-white overflow-y-auto flex flex-col md:static md:z-auto md:w-[232px] md:translate-x-0 border-r border-white/10 shadow-lg md:shadow-none"
>
  <div class="px-5 pt-5 pb-4 flex items-center gap-3 border-b border-white/10">
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-lg bg-white/10 border border-white/20 p-1 flex items-center justify-center shrink-0 shadow-xs">
        <img
          src="/logo.svg"
          alt="Habitar"
          class="w-full h-full object-contain filter invert brightness-200"
        />
      </div>
      <div>
        <span class="text-base font-bold text-white tracking-tight block leading-tight">Habi<span class="text-emerald-300">tar</span></span>
        <div class="text-[10px] text-emerald-200/70 font-semibold uppercase tracking-wider">{sectionLabel}</div>
      </div>
    </a>
  </div>

  <nav class="px-3 py-4 flex flex-col gap-1">
    {items.map((item) => {
      const isActive = currentPath === item.href.replace(/\/$/, '');
      return (
        <a
          href={item.href}
          class={`group relative flex items-center gap-3 px-3 py-2.5 rounded-lg text-xs font-semibold transition-all ${
            isActive ? 'bg-white/15 text-white shadow-2xs font-bold' : 'text-white/70 hover:bg-white/10 hover:text-white'
          }`}
        >
          {isActive && <span class="absolute left-0 top-1/2 -translate-y-1/2 h-[18px] w-[3.5px] rounded-r-full bg-emerald-400" />}
          <Icon name={item.icon} size={16} class={isActive ? 'text-emerald-300' : 'text-white/50 group-hover:text-white/80'} />
          <span class="flex-1 truncate">{item.label}</span>
          {item.badgeCount !== undefined && item.badgeCount > 0 && (
            <span class="bg-rose-500 text-white text-[10px] min-w-[18px] h-[18px] px-1.5 rounded-full font-bold flex items-center justify-center shadow-2xs">
              {item.badgeCount}
            </span>
          )}
        </a>
      );
    })}
  </nav>

  <div class="mt-auto px-5 py-4 text-[10.5px] text-white/40 border-t border-white/10 flex items-center justify-between">
    <span>Habitar © {new Date().getFullYear()}</span>
    <span class="text-[9.5px] text-emerald-300/60 font-mono">v2.0</span>
  </div>
</aside>

<script>
  function initSidebar() {
    const sidebar = document.getElementById('app-sidebar');
    const backdrop = document.getElementById('sidebar-backdrop');
    const toggle = document.getElementById('sidebar-toggle');
    if (!sidebar || !backdrop || !toggle) return;

    function open() {
      sidebar?.classList.remove('-translate-x-full');
      backdrop?.classList.remove('hidden');
    }

    function close() {
      sidebar?.classList.add('-translate-x-full');
      backdrop?.classList.add('hidden');
    }

    toggle.addEventListener('click', () => {
      if (sidebar?.classList.contains('-translate-x-full')) open();
      else close();
    });
    backdrop.addEventListener('click', close);
    sidebar?.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
  }

  initSidebar();
  document.addEventListener('astro:page-load', initSidebar);
</script>
