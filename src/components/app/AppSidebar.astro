---
import Icon from './Icon.astro';
import type { IconName } from '../../lib/iconPaths';

export interface AppSidebarItem {
  icon: IconName;
  label: string;
  href: string;
  badgeCount?: number;
}

interface Props {
  items: AppSidebarItem[];
  sectionLabel: string;
}

const { items, sectionLabel } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<div
  id="sidebar-backdrop"
  class="hidden fixed inset-0 bg-black/40 backdrop-blur-sm z-30 md:hidden transition-opacity"
></div>
<aside
  id="app-sidebar"
  class="fixed inset-y-0 left-0 z-40 w-[260px] -translate-x-full transition-transform duration-200 ease-out shrink-0 overflow-y-auto flex flex-col md:static md:z-auto md:w-[240px] md:translate-x-0 shadow-xl md:shadow-none"
  style="background: linear-gradient(180deg, #0B5D49 0%, #073D30 100%);"
>
  <div class="px-5 pt-5 pb-4 flex items-center gap-3">
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-9 h-9 rounded-xl bg-white/10 border border-white/15 p-1.5 flex items-center justify-center shrink-0 backdrop-blur-sm">
        <img
          src="/logo.svg"
          alt="Habitar"
          class="w-full h-full object-contain brightness-0 invert"
        />
      </div>
      <div>
        <span class="text-[15px] font-bold text-white tracking-tight block leading-tight">Habitar</span>
        <div class="text-[10px] text-emerald-200/60 font-medium uppercase tracking-widest" data-i18n={sectionLabel}>{sectionLabel}</div>
      </div>
    </a>
  </div>

  <div class="mx-4 border-t border-white/10 mb-1"></div>

  <nav class="px-3 py-3 flex flex-col gap-0.5 flex-1">
    {items.map((item) => {
      const isActive = currentPath === item.href.replace(/\/$/, '');
      return (
        <a
          href={item.href}
          class={`group relative flex items-center gap-3 px-3 py-2.5 rounded-lg text-[13px] font-medium transition-all duration-150 ${
            isActive
              ? 'bg-white/15 text-white shadow-sm backdrop-blur-sm'
              : 'text-white/65 hover:bg-white/8 hover:text-white/90'
          }`}
        >
          {isActive && <span class="absolute left-0 top-1/2 -translate-y-1/2 h-5 w-[3px] rounded-r-full bg-emerald-300" />}
          <Icon name={item.icon} size={17} class={`shrink-0 transition-colors duration-150 ${isActive ? 'text-emerald-300' : 'text-white/45 group-hover:text-white/70'}`} />
          <span class="flex-1 truncate" data-i18n={item.label}>{item.label}</span>
          {item.badgeCount !== undefined && item.badgeCount > 0 && (
            <span class="bg-rose-500/90 text-white text-[10px] min-w-[18px] h-[18px] px-1.5 rounded-full font-bold flex items-center justify-center">
              {item.badgeCount}
            </span>
          )}
        </a>
      );
    })}
  </nav>

  <div class="px-5 py-4 text-[10px] text-white/30 border-t border-white/8 flex items-center justify-between">
    <span>Habitar © {new Date().getFullYear()}</span>
    <span class="text-[9px] text-emerald-300/40 font-mono tracking-wide">v2.0</span>
  </div>
</aside>

<script>  function initSidebar() {
    const sidebar = document.getElementById('app-sidebar');
    const backdrop = document.getElementById('sidebar-backdrop');
    const toggle = document.getElementById('sidebar-toggle');
    if (!sidebar || !backdrop || !toggle) return;

    function open() {
      sidebar?.classList.remove('-translate-x-full');
      backdrop?.classList.remove('hidden');
    }

    function close() {
      sidebar?.classList.add('-translate-x-full');
      backdrop?.classList.add('hidden');
    }

    toggle.addEventListener('click', () => {
      if (sidebar?.classList.contains('-translate-x-full')) open();
      else close();
    });
    backdrop.addEventListener('click', close);
    sidebar?.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
  }

  initSidebar();
  document.addEventListener('astro:page-load', initSidebar);
</script>
