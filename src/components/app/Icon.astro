---
import { iconPaths, type IconName } from '../../lib/iconPaths';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 16, class: className = '' } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={`shrink-0 ${className}`}
  set:html={iconPaths[name]}
/>
